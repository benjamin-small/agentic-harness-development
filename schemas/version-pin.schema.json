{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Poietic Harness exact version pin",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[1-9][0-9]{2,3}\\.(0|[1-9][0-9]{0,5})$",
      "description": "Exact UTC timestamp; the runtime also checks calendar validity."
    }
  }
}
