{
  "name": "@benjamin-small/agentic-harness-development",
  "version": "0.1.0-alpha.1",
  "description": "Portable agent skills, harness specialists, and versioned development tooling.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Benjamin Small",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjamin-small/agentic-harness-development.git"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "bin": {
    "harness-kit": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "skills",
    "agents",
    "schemas",
    "catalog.json",
    "docs",
    "BOOTSTRAP.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run build && node dist/src/cli.js validate",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:coverage": "npm run build && c8 --include 'dist/src/**' --reporter=text --reporter=json-summary node --test dist/test/*.test.js",
    "check": "npm run format:check && npm run typecheck && npm run test:coverage && node dist/src/cli.js validate",
    "release:pack": "npm run check && node scripts/package-release.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "c8": "12.0.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
